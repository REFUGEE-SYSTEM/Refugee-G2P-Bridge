COMPOSE_PROJECT_NAME=refugee-g2p-bridge

# Host ports
BRIDGE_POSTGRES_PORT=5736
BRIDGE_REDIS_PORT=6681
BRIDGE_API_PORT=8395
EXAMPLE_BANK_PORT=8396

# Dedicated Bridge & Example Bank Postgres
BRIDGE_DB_USER=bridgeuser
BRIDGE_DB_PASSWORD=__CHANGE_ME__
BRIDGE_DB_NAME=g2pbridgedb
EXAMPLE_BANK_DB_NAME=examplebankdb

# External SPAR Mapper API (published host port via host.docker.internal)
SPAR_MAPPER_PORT=8390

# Fictional Example Bank Treasury (UGX)
EXAMPLE_BANK_TREASURY_ACCOUNT_NUMBER=1000000001
EXAMPLE_BANK_TREASURY_ACCOUNT_CURRENCY=UGX
EXAMPLE_BANK_TREASURY_AVAILABLE_BALANCE=1000000000
EXAMPLE_BANK_TREASURY_ACCOUNT_HOLDER_NAME="Refugee Program Treasury"
